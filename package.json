{
  "name": "retro-arcade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/finalize-build.mjs",
    "build:e2e": "node scripts/build-e2e.mjs",
    "capture:screenshots": "npm run build:e2e && node scripts/capture-screenshots.mjs",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run src",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
